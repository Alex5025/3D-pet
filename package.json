{
  "name": "vrm-pet",
  "version": "0.1.0",
  "description": "Desktop VRM pet — rendering follows pixiv/three-vrm official examples verbatim",
  "productName": "VRM Pet",
  "author": "3D-pet contributors",
  "main": "out/main/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:all": "node scripts/check-secrets.mjs --tracked",
    "predev": "node scripts/cleanup-dev.mjs",
    "dev": "electron-vite dev",
    "start": "zsh scripts/start-pet-system.sh",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.vrmpet.desktop",
    "asar": true,
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models/AvatarSample_A.vrm",
        "to": "models/AvatarSample_A.vrm"
      },
      {
        "from": "src/main/agent",
        "to": "agent-helpers",
        "filter": [
          "*.mjs"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@types/three": "^0.169.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.7",
    "three": "^0.169.0"
  }
}
